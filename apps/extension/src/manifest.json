{
  "manifest_version": 3,
  "name": "Lume · Importar da Udemy, Alura e Fundação Bradesco",
  "version": "0.2.0",
  "description": "Lê a lista dos seus cursos (você já logado) na Udemy, na Alura ou na Escola Virtual da Fundação Bradesco e leva para o seu Lume local.",
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.udemy.com/*"
      ],
      "js": [
        "content-udemy.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "__APP_ORIGIN__/importar*"
      ],
      "js": [
        "content-app.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://*.alura.com.br/*"
      ],
      "js": [
        "content-alura.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.ev.org.br/*"
      ],
      "js": [
        "content-bradesco.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "__APP_ORIGIN__/*"
  ]
}
